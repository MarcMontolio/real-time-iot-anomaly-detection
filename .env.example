APP_NAME=Real-Time IoT Anomaly Detection System
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@ip:port/iot_anomaly
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@ip:port/iot_anomaly

TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@ip:port/iot_anomaly_test
TEST_DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@ip:port/iot_anomaly_test

REDIS_URL=redis://localhost:6379/0

MQTT_HOST=localhost
MQTT_PORT=1883

LOG_LEVEL=INFO